{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adaptiveagents.io/envelope-v1.schema.json",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string",
      "format": "uuid"
    },
    "task_type": {
      "type": "string",
      "const": "research"
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "breadth_hint": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "deadline_ms": {
      "type": "integer",
      "exclusiveMinimum": 0
    },
    "budget_usd": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "forced_topology": {
      "type": "string",
      "enum": ["SOLO", "CHAIN", "FAN_OUT", "SUPERVISOR"]
    }
  },
  "required": ["task_id", "task_type", "prompt"]
}
